# 复制为项目根目录 .env 后填写真实配置
LLM_API_KEY=
LLM_BASE_URL=https://www.blackaicoding.com
LLM_MODEL=gpt-5.5
LLM_WIRE_API=responses
LLM_REASONING_EFFORT=low
REQUEST_TIMEOUT=120

# SQLite 数据库文件
DATABASE_PATH=data/fun_research.db

# 前端开发服务器地址
FRONTEND_ORIGIN=http://localhost:5173

# 管理后台密码，默认 10124
ADMIN_PASSWORD=10124
