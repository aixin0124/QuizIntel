# 复制为项目根目录 .env 后填写真实配置
LLM_API_KEY=
LLM_BASE_URL=https://www.blackaicoding.com
LLM_MODEL=gpt-5.5
LLM_WIRE_API=chat_completions
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=6000

# 基元律动兜底接口：主 gpt-5.5 接口失败时自动切换
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://tokenrhythm.studio/v1
LLM_FALLBACK_MODEL=deepseek-v4-flash
REQUEST_TIMEOUT=300

# MySQL 8 数据库地址；SQLite 路径保留给测试和旧数据迁移
DATABASE_URL=mysql+pymysql://root:xxxxx@127.0.0.1:3306/fun_research?charset=utf8mb4
DATABASE_PATH=data/fun_research.db

# 前端开发服务器地址
FRONTEND_ORIGIN=http://localhost:5173

# 首次初始化会创建普通演示账号：aixin / 123456
